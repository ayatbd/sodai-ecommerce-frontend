# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/sodai_ecommerce

# JSON Web Token Secret & Expiry
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_replace_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
